# Local defaults for docker compose. Copy to .env. Do not put a service-account key here.
DATABASE_URL=postgres://outreach:outreach@127.0.0.1:54329/outreach
DATABASE_URL_TEST=postgres://outreach:outreach@127.0.0.1:54329/outreach_test
REDIS_URL=redis://127.0.0.1:63799

# Kill switch. Only the exact value true allows the send path to leave the gate.
# Default is false. This file ships with sending off.
SENDING_ENABLED=false

# dry-run | seed-only | live. dry-run sends nothing. seed-only sends only to seed_addresses.
SEND_MODE=dry-run

# Absolute path to the Google service-account JSON, on the machine that has the key.
# Leave this empty here. Do not commit the JSON. Tests use the mock adapter and never read a key.
# On that machine: export GMAIL_SA_KEY_PATH=/absolute/path/sa.json
#   npm run inbox:check
#   npm run inbox:sync -- --inbox divyam@usefigcel.com --limit 50
#   npm run inbox:schedule
GMAIL_SA_KEY_PATH=

# Local star, read, archive, snooze, and label changes are queued.
# Only the exact value true applies them with messages.modify.
# Sync stays read-only either way. Default is false.
GMAIL_MIRROR_ENABLED=false

# Sign-in. Leave the Google values empty. This process does not call Google until both are set.
# They are TODO. Do not invent a client id or secret.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
# Exact value true turns on password and magic-link sign-in. Default off.
# Magic-link mail delivery is TODO: mailer. The raw token is not logged.
LOCAL_LOGIN_ENABLED=false
# First admin, invited on boot when no admin exists. Example: divyam@usefigcel.com
BOOTSTRAP_ADMIN_EMAIL=
# Signs the session cookie. Empty uses a local placeholder that is not a credential.
# Set a long random value before anyone else can reach this process.
SESSION_SECRET=
